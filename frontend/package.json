{
  "name": "storyweaver-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test accessibility.spec.ts keyboard.spec.ts --workers=1",
    "test:visual": "playwright test visual.spec.ts --workers=1",
    "test:performance": "pnpm build && node scripts/check-bundle-budget.mjs && playwright test performance.spec.ts --workers=1",
    "demo:record": "playwright test --config=playwright.demo.config.ts"
  },
  "dependencies": {
    "@tanstack/vue-query": "5.101.4",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-highlight": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "@tiptap/vue-3": "3.29.2",
    "echarts": "6.0.0",
    "element-plus": "2.14.3",
    "pinia": "4.0.2",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.10.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  }
}
