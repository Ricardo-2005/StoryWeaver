APP_PORT=8080

POSTGRES_DB=storyweaver
POSTGRES_USER=storyweaver
POSTGRES_PASSWORD=replace_me
POSTGRES_PORT=5432

REDIS_PORT=6379

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_me

JAVA_OPTS=-XX:MaxRAMPercentage=75.0

JWT_SECRET=replace_with_at_least_32_random_bytes
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_USER_ID_SECRET=replace_with_a_separate_random_hmac_secret

EMBEDDING_ENABLED=true
EMBEDDING_MODELS_DIR=./models
EMBEDDING_MODEL_URI=file:/models/model.onnx
EMBEDDING_TOKENIZER_URI=file:/models/tokenizer.json
EMBEDDING_DIMENSIONS=512

WORKFLOW_STALE_RUN_TIMEOUT=15m
WORKFLOW_HEARTBEAT_INTERVAL=15s
WORKFLOW_RECOVERY_INTERVAL=30s
WORKFLOW_CONTEXT_TTL=30m
WORKFLOW_EVENT_STREAM_TIMEOUT=5m
WORKFLOW_EVENT_POLL_INTERVAL=250ms
WORKFLOW_MAX_ACTIVE_RUNS_PER_PROJECT=1
BUDGET_TASK_TOKEN_LIMIT=40000
BUDGET_USER_DAILY_COST_LIMIT=100.00000000
BUDGET_PROJECT_COST_LIMIT=1000.00000000
BUDGET_WRITER_OUTPUT_TOKEN_LIMIT=12000
BUDGET_PLANNER_REASONING_TOKEN_LIMIT=6000
